# Serve the statically-built Next.js output from /out/ as if it were the site root.
# Hostinger points public_html/ at this repo, so requests come in at "/", but the
# actual HTML lives in /out/ after next build. This rewrite bridges the two.

# `index.html` eerst: submappen zoals out/privacy/ hebben hun eigen index.html.
# Zonder die eerste waarde zoekt Apache naar out/privacy/out/index.html, vindt
# niets, weigert de directory listing en geeft 403 op elke subpagina.
DirectoryIndex index.html out/index.html

RewriteEngine On
RewriteBase /

# www.disseldesign.com → https://disseldesign.com (301). Next.js kan dit bij een
# statische export niet zelf, dus het staat hier. Alleen voor de www-host:
# disseldesign.com en dev.disseldesign.com vallen er niet onder.
RewriteCond %{HTTP_HOST} ^www\.disseldesign\.com$ [NC]
RewriteRule ^(.*)$ https://disseldesign.com/$1 [R=301,L]

# Don't rewrite requests that are already inside /out/ — they resolve normally.
RewriteRule ^out/ - [L]

# AI-agents die om Markdown vragen krijgen op de homepage llms.txt, de
# Markdown-samenvatting van de site. Browsers sturen nooit text/markdown.
# shortcut: kijkt niet naar q-waarden, pas aan als iemand text/markdown;q=0 stuurt.
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteRule ^$ out/llms.txt [L]

# Root request → out/index.html
RewriteRule ^$ out/index.html [L]

# Anything that isn't an existing file/directory → look inside /out/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ out/$1 [L]

# Fallback for trailing-slash URLs that Next generates as directories.
# 404.php kiest: HTML voor browsers, Markdown (out/404.md) voor agents.
ErrorDocument 404 /404.php

AddType "text/markdown; charset=utf-8" .md
# llms.txt is Markdown: zo voor agents, platte tekst voor browsers
# (text/markdown laat een browser het bestand downloaden).
<Files "llms.txt">
  Header set Content-Type "text/markdown; charset=utf-8" "expr=%{HTTP_ACCEPT} =~ m#text/markdown#i"
</Files>
# Zelfde URL, andere inhoud per Accept: caches moeten dat weten.
<FilesMatch "\.(html|md)$|^llms\.txt$">
  Header merge Vary Accept
</FilesMatch>

# dev.disseldesign.com is de testomgeving en hoort niet in Google. Dezelfde
# .htaccess draait ook op live, maar daar matcht de host niet en komt de
# header er niet bij.
# Na de interne rewrite naar out/ kan Apache de variabele hernoemen naar
# REDIRECT_DD_NOINDEX; daarom staan beide varianten erin.
SetEnvIfNoCase Host ^dev\.disseldesign\.com$ DD_NOINDEX
Header set X-Robots-Tag "noindex, nofollow" env=DD_NOINDEX
Header set X-Robots-Tag "noindex, nofollow" env=REDIRECT_DD_NOINDEX
